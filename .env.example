# Доступ по логину и паролю; Timeweb Cloud также использует сессию Chromium.
# Обход: авторизация и чтение данных. Без нажатий кнопок и изменений в кабинетах.
# Пароли с # или пробелами заключайте в одинарные кавычки.
# Не отправляйте этот файл в Git или в чат.

# Timeweb Cloud
# auto: сессия Chromium, если профиль существует; иначе логин и пароль.
TIMEWEB_CLOUD_AUTH=auto
# Необязательно: каталог профиля (по умолчанию ~/.config/chromium/Default).
# TIMEWEB_CLOUD_CHROMIUM_PROFILE=/home/user/.config/chromium/Default
TIMEWEB_CLOUD_LOGIN=
TIMEWEB_CLOUD_PASSWORD=

# Timeweb Hosting
TIMEWEB_HOSTING_LOGIN=
TIMEWEB_HOSTING_PASSWORD=

# SmartVhod
SMARTVHOD_LOGIN=
SMARTVHOD_PASSWORD=

# CRM Aspro
ASPRO_LOGIN=
ASPRO_PASSWORD=

# Параметры отчёта и прогноза SmartVhod
CHECKLIST_TIMEZONE=Europe/Moscow
SMARTVHOD_HORIZON_DAYS=30
SMARTVHOD_LEAD_DAYS=3
